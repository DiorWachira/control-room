# Copy to .env (never commit .env). Leave PROMETHEUS_URL empty to run the built-in replay.

# Live mode: the engine queries Prometheus every EVAL_INTERVAL_S seconds.
PROMETHEUS_URL=
EVAL_INTERVAL_S=60

# Resolve incident adapter (needs the endpoint proposed in docs/resolve-api.md).
RESOLVE_URL=
RESOLVE_TOKEN=

# Pager: Telegram first, else a generic JSON webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGER_WEBHOOK_URL=

# Probe mode (what the public site runs): directory holding runs/*.jsonl
CONTROLROOM_PROBE_DATA=
CONTROLROOM_PROBES=

# Live mode extras
CONTROLROOM_STATE_DB=controlroom-state.db
HEALTHCHECK_URL=

# Postmortem rewrite (pip install -e ".[llm]")
ANTHROPIC_API_KEY=

# Optional overrides
CONTROLROOM_SLOS=
CONTROLROOM_WEB_DIST=

# infra/docker-compose.yml (Grafana admin login; required by compose)
GRAFANA_ADMIN_PASSWORD=
