# Copy to .env (never commit .env). Leave PROMETHEUS_URL empty to run the built-in replay.

# Live mode: the engine queries Prometheus every EVAL_INTERVAL_S seconds.
PROMETHEUS_URL=
EVAL_INTERVAL_S=60

# Resolve incident adapter (needs the endpoint proposed in docs/resolve-api.md).
RESOLVE_URL=
RESOLVE_TOKEN=

# Pager: Telegram first, else a generic JSON webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGER_WEBHOOK_URL=

# Optional overrides
CONTROLROOM_SLOS=
CONTROLROOM_WEB_DIST=
